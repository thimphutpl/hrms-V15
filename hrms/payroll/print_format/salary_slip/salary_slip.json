 "html": "{%- if letter_head and not no_letterhead -%}\n    <div class=\"letter-head\">{{ letter_head }}</div>\n{%- endif -%}\n\n<style>\n    .bold-table,\n    .bold-table td,\n    .bold-table th {\n        border: 1px solid #000 !important;\n        border-collapse: collapse !important;\n    }\n\n    .table1,\n    .table1 td,\n    .table1 th {\n        border: 1px solid #000 !important;\n        border-collapse: collapse !important;\n    }\n\n    .table1 td,\n    .table1 th,\n    .bold-table td,\n    .bold-table th {\n        padding: 6px 8px;\n        vertical-align: middle;\n    }\n\n    .printedby {\n        margin-top: 10px;\n        font-size: 9pt;\n    }\n\n    #main h3,\n    #main h5 {\n        margin: 0;\n        padding: 0;\n    }\n</style>\n\n<div id=\"footer-html\" class=\"visible-pdf\">\n    {% if not no_letterhead and footer %}\n    <div class=\"letter-head-footer\">\n        {{ footer }}\n    </div>\n    {% endif %}\n    <p class=\"text-center small page-number visible-pdf\">\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n    </p>\n</div>\n\n<div id=\"main\">\n    <h3 align=\"center\">SALARY SLIP</h3>\n    <h5 align=\"center\"><u>{{ doc.branch }}</u></h5>\n</div>\n\n<div style=\"margin-top: 10px;\">\n    <table class=\"table1\" style=\"margin-top: 1px; font-size:9pt; width:100%;\">\n        <tr>\n            <td><strong>Employee Name:</strong> {{ doc.employee_name }}</td>\n            <td><strong>Designation:</strong> {{ doc.designation }}</td>\n        </tr>\n        <tr>\n            <td><strong>Employee Code:</strong> {{ doc.employee }}</td>\n            <td><strong>Bank Details:</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"bank_ac_no\") }} ({{ frappe.db.get_value(\"Employee\", doc.employee, \"bank_name\") }})</td>\n        </tr>\n        <tr>\n            <td><strong>Citizen ID:</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"passport_number\") }}</td>\n            <td><strong>Tax Payer Number (TPN):</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"tpn_number\") }}</td>\n        </tr>\n        <tr>\n            <td><strong>Date:</strong> {{ frappe.utils.formatdate(doc.start_date) }} to {{ frappe.utils.formatdate(doc.end_date) }}</td>\n            <td><strong>Employee Grade:</strong> {{ doc.employee_grade }}</td>\n        </tr>\n    </table>\n</div>\n\n<table class=\"table table-bordered bold-table\" style=\"font-size:9pt; width:100%; margin-top:10px;\">\n    <tbody>\n        <tr>\n            <td>\n                <table class=\"bold-table\" style=\"width: 100%; font-size:9pt !important;\">\n                    <tr>\n                        <th style=\"text-align:center;\">Earnings</th>\n                        <th style=\"text-align:center;\">Amount</th>\n                    </tr>\n                    {%- for row in doc.earnings -%}\n                    <tr>\n                        <td>{{ row.salary_component }}</td>\n                        <td class=\"text-right\">{{ frappe.format_value(row.amount, {\"fieldtype\":\"Currency\"}) }}</td>\n                    </tr>\n                    {%- endfor -%}\n                </table>\n            </td>\n\n            <td>\n                <table class=\"bold-table\" style=\"width: 100%; font-size:9pt !important;\">\n                    <tr>\n                        <th style=\"text-align:center;\">Deductions</th>\n                        <th style=\"text-align:center;\">Amount</th>\n                    </tr>\n                    {%- for duc in doc.deductions -%}\n                    <tr>\n                        <td>{{ duc.salary_component }}</td>\n                        <td class=\"text-right\">{{ frappe.format_value(duc.amount, {\"fieldtype\":\"Currency\"}) }}</td>\n                    </tr>\n                    {%- endfor -%}\n                </table>\n            </td>\n        </tr>\n\n        <tr>\n            <td colspan=\"4\">\n                <table class=\"bold-table\" style=\"width: 100%; font-size:9pt;\">\n                    <tr>\n                        <td style=\"width: 25%;\"><b>Total Earnings</b></td>\n                        <td style=\"width: 25%;\" class=\"text-right\"><strong>{{ frappe.format_value(doc.gross_pay, {\"fieldtype\":\"Currency\"}) }}</strong></td>\n                        <td style=\"width: 25%;\"><b>Total Deductions</b></td>\n                        <td style=\"width: 25%;\" class=\"text-right\"><strong>{{ frappe.format_value(doc.total_deduction, {\"fieldtype\":\"Currency\"}) }}</strong></td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"2\"></td>\n                        <td><b>Net Amount</b></td>\n                        <td class=\"text-right\">{{ frappe.format_value(doc.net_pay, {\"fieldtype\":\"Currency\"}) }}</td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"4\"><b>Amount in Words:</b> {{ doc.total_in_words }}</td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"4\" style=\"height:40px;\"></td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"2\"></td>\n                        <td colspan=\"2\" style=\"text-align: right;\">For Construction Development Corporation Ltd.</td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"4\" style=\"height:50px;\"></td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"2\"></td>\n                        <td colspan=\"2\" style=\"text-align: right;\">Authorized Signatory</td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </tbody>\n</table>\n\n<div style=\"padding-top: 100px; clear: both;\"></div>\n\n<div>\n    The main pay components are basic pay, corporate allowance and contract allowance. Other allowances are subject to change when the employees are reverted from the project.\n</div>\n\n<div class=\"printedby\">\n    This print is system generated and should be considered VALID only with appropriate seal and/or signature.\n    <br>\n    Printed by {{ frappe.user }} on {{ frappe.utils.nowdate() }} at {{ frappe.utils.nowtime() }}\n</div>",
