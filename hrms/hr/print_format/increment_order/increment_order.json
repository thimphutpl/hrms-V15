 "html": "<div class=\"page-break\">\r\n\t<div id=\"header-html\" class=\"hidden-pdf\">\r\n\t\t{%- if letter_head and not no_letterhead -%}\r\n\t\t<div class=\"letter-head\" style=\"font-family: 'Times New Roman', serif;\">\r\n\t\t\t{{ letter_head }}\r\n\t\t</div>\r\n\t\t{%- endif -%}\r\n\t</div>\r\n\t<main style=\"font-family: 'Times New Roman', Times, serif;\">\r\n    <div style=\"font-size:16px;font-weight:semi-bold;\">\r\n    <div style=\"display:flex;gap:350px\">\r\n        <p>Date: HMS/HR-09/{{ doc.fiscal_year }}</p>\r\n        <p>{{ doc.posting_date }}</p>\r\n    </div>\r\n    <h1 style=\"margin-left:200px; font-family: 'Times New Roman', Times, serif;\">OFFICE ORDER</h1>\r\n    <p style=\"font-family: 'Times New Roman', Times, serif;\">Sanctioned is hereby accorded for the grant of annual increment falling due on 1st July,2024 for Others of\r\ndifferent sector under this His Majesty's Secretariat as per list attached.</p>\r\n</div>\r\n</main>\r\n<div style=\"margin-top:50px; font-family: 'Times New Roman', Times, serif;font-size:16px;margin-top:30px;\">\r\n    <p>Phuntsho Norbu</p>\r\n    <p>Dy. Chief HR Officer</p>\r\n</div>\r\n\r\n<div style=\"font-family: 'Times New Roman', Times, serif;;font-size:16px;margin-top:30px;\">\r\n    <p>Copy to:</p>\r\n    <p>1. Chief Finance Officer, Ministry of Finance for kind information and necessary action </p>\r\n    <p>2. Finance officer, HMS for necessary action</p>\r\n</div>\r\n\r\n<body>\r\n    <div style=\"font-family: 'Times New Roman';margin-top:50px;font-size:16px \">\r\n        <p style=\"font-weight: bold; text-align: center; margin-bottom: 20px;\">List of Employees for Increment Due for July, 2024</p>\r\n    </div>\r\n    <table border=\"1\" cellspacing=\"0\" cellpadding=\"8\" style=\"border-collapse: collapse; width: 100%; font-size: 12px;\">\r\n        <thead>\r\n            <tr style=\"background-color: #f2f2f2; font-weight: bold;\">\r\n                <th style=\"width: 5%;\">SNO</th>\r\n                <th style=\"width: 15%;\">Name</th>\r\n                <th style=\"width: 10%;\">EID No#</th>\r\n                <th style=\"width: 20%;\">Position Title</th>\r\n                <th style=\"width: 15%;\">Agency</th>\r\n                <th style=\"width: 12.5%;\">Current Basic Pay</th>\r\n                <th style=\"width: 12.5%;\">Basic Pay After Increment</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.employees %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td>{{ item.employee_name }}</td>\r\n                <td>{{ item.employee }}</td>\r\n                <td>{{ item.department }}</td>\r\n                <td>{{ item.designation }}</td>\r\n                <td>{{ item.current_basic_pay }}</td>\r\n                <td>{{ item.new_basic_pay }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n</body>\r\n\r\n\r\n</div>\r\n",
